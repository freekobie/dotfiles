# window settings
window-theme = ghostty
maximize = true
window-width = 140
window-height = 35
window-padding-x = 5
window-padding-y = 5

# GTK settings
gtk-titlebar-hide-when-maximized = true

# Appearance
theme = JetDark

font-family = Monaspace Argon
font-size = 13
font-feature = ss07, ss08, liga, calt, cv10, cv11
cursor-style = block
shell-integration-features = no-cursor
